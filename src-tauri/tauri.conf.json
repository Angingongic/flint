{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flint",
  "version": "0.1.5",
  "identifier": "com.flint.study",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flint",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": [
          "flint"
        ],
        "name": "Flint study set",
        "description": "Portable Flint study set",
        "role": "Editor",
        "mimeType": "application/x-flint-set",
        "exportedType": {
          "identifier": "com.flint.study.set",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Angingongic/flint/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RkI5MzY4MzU4RUM5ODYKUldTR3lZNDFhSlA3cDQzV0UwQWNDdlpNYzg2UGdrd3RpMytaMmNNZEJGOXVndEsxVmtoLzRTVmsK"
    }
  }
}
